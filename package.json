{
  "name": "factory-desktop-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview",
    "package:server": "mkdir -p release && tar --exclude='./node_modules' --exclude='./.git' --exclude='./release' --exclude='./dist' --exclude='./.factory-server-data' --exclude='./.env' --exclude='./.env.local' --exclude='./.env.production' --exclude='./factory.env' --exclude='*.log' --exclude='.DS_Store' -czf release/factory-desk-v2.tar.gz .",
    "dev:full": "concurrently -k \"node server/index.js\" \"vite\"",
    "backup:full": "node scripts/full-backup.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "element-plus": "^2.8.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "vite": "^5.4.11"
  }
}
