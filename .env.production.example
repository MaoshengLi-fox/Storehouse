# Reference only: the Node.js server does not automatically load .env files.
# PM2 deployment uses the env fields in ecosystem.config.cjs.

# Server runtime
FACTORY_SHARED_HOST=0.0.0.0
FACTORY_SHARED_PORT=8787
FACTORY_BUSINESS_TIMEZONE=Asia/Shanghai

# Persistent data root
FACTORY_STORAGE_ROOT=/opt/factory-desk/data

# Auth bootstrap
FACTORY_ADMIN_USERNAME=admin
FACTORY_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
FACTORY_ADMIN_DISPLAY_NAME=系统管理员
FACTORY_SESSION_TTL_HOURS=168
