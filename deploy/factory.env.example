# Template for /opt/factory-desk/factory.env on the server (read by ecosystem.config.cjs).
#   sudo cp deploy/factory.env.example /opt/factory-desk/factory.env
#   sudo chown factory:factory /opt/factory-desk/factory.env && sudo chmod 600 /opt/factory-desk/factory.env
# Never commit or upload the real file. The Node.js server itself does not read .env files.

# Business time zone used for business dates and price effectivity (IANA name)
FACTORY_BUSINESS_TIMEZONE=Asia/Shanghai

# Persistent data root (business db, auth db, backups)
FACTORY_STORAGE_ROOT=/opt/factory-desk/data

# First admin account — only used when the system has no admin account at all (first start).
# Production refuses to start with the default/placeholder or a password shorter than 10 characters.
FACTORY_ADMIN_USERNAME=admin
FACTORY_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD
FACTORY_ADMIN_DISPLAY_NAME=系统管理员

# Login session lifetime in hours (168 = 7 days)
FACTORY_SESSION_TTL_HOURS=168

# Only needed if the web pages are served from a different origin than the API (normally leave empty)
# FACTORY_CORS_ORIGIN=https://factory.example.com

# Host/port are fixed by ecosystem.config.cjs: Node listens on 127.0.0.1:8787 behind Nginx.
